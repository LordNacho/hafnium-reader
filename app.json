{
  "expo": {
    "name": "Hafnium Reader",
    "slug": "hafnium-reader",
    "scheme": "hafniumreader",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ltd.hafnium.reader",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ltd.hafnium.reader",
      "adaptiveIcon": {
        "backgroundColor": "#0D1322",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1322",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D1322"
          }
        }
      ]
    ],
    "owner": "hafnium-research",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ea220ea3-c26a-4068-9ec9-fd8425b1283a"
      }
    }
  }
}
